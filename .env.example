# Pelindo Regional 4 (R4 PortDash) Environment Configuration

# 1. Google Sheets & Google Drive Integration
GOOGLE_ACCOUNT_EMAIL="regdashr@gmail.com"
GOOGLE_SHEETS_API_KEY=""
GOOGLE_SPREADSHEET_ID=""

# 2. Database Configuration
# Default: Local SQLite (Node 24+ native)
DATABASE_URL="file:./data/ed_dashboard.db"
DATABASE_PATH="data/ed_dashboard.db"
DATABASE_USER="regdashr@gmail.com"

# Optional: PostgreSQL Database (Production Cloud SQL / Supabase)
# POSTGRES_URL="postgres://regdashr:password@host:5432/ed_dashboard"

# 3. Authentication & JWT Security
JWT_SECRET="replace-with-32-byte-high-entropy-secret-in-production"
JWT_EXPIRES_IN="8h"
NEXT_PUBLIC_ENABLE_DEMO_LOGIN="true"

# 4. Tunneling & Deployment
# Simpan token Cloudflare tunnel di environment/secret manager, jangan di commit ke repo
CLOUDFLARE_TUNNEL_TOKEN=""
