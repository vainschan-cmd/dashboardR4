# Konfigurasi Lingkungan PortSight — Executive Dashboard Pelindo Regional 4
# Salin file ini ke .env.local (atau atur pada environment produksi)

# Wajib di lingkungan produksi: minimal 32 karakter acak kriptografis (mis. openssl rand -hex 32)
JWT_SECRET=ganti_dengan_secret_kriptografis_minimal_32_karakter_acak_hs256

# Kunci enkripsi untuk kredensial yang disimpan di db_config.json & integration_settings
# (AES-256-GCM). Isi dengan 32 byte acak dalam hex/base64, mis. `openssl rand -hex 32`.
# Bila kosong, kunci diturunkan dari JWT_SECRET (kurang ideal: rotasi JWT membuat
# secret tersimpan tidak terbaca).
SECRETS_ENCRYPTION_KEY=

# Wajib saat akun awal dibuat (seed/import) di produksi: minimal 12 karakter.
# Di development, bila kosong, sistem membuat kata sandi acak per akun dan mencetaknya sekali di log server.
# Kebijakan kata sandi aplikasi: minimal 12 karakter, minimal 6 karakter berbeda, tanpa spasi di awal/akhir.
BOOTSTRAP_PIC_PASSWORD=

# Lokasi file SQLite di dalam direktori ./data (opsional, default: data/ed_dashboard.db)
DATABASE_PATH=data/ed_dashboard.db

# Pendaftaran mandiri tanpa sesi admin dinonaktifkan secara default (false)
ALLOW_PUBLIC_REGISTRATION=false
# Harus sama dengan ALLOW_PUBLIC_REGISTRATION agar tombol daftar tampil konsisten di UI
NEXT_PUBLIC_ALLOW_PUBLIC_REGISTRATION=false

# API Key Google Sheets (opsional, juga dapat diatur melalui menu Konfigurasi Sistem)
GOOGLE_SHEETS_API_KEY=

# Set true hanya jika aplikasi berada di belakang reverse proxy/Cloudflare yang Anda kendalikan.
# Jika false, header X-Forwarded-For diabaikan (mencegah spoofing rate limit).
TRUST_PROXY=false

# Origin tambahan yang dipercaya untuk permintaan mutasi (CSRF), dipisahkan koma.
# Contoh: https://dashboard.internal.example
CSRF_TRUSTED_ORIGINS=

# Durasi idle sesi (menit) diatur dari menu Konfigurasi Sistem, bukan dari env.
# Token akses berlaku 15 menit dan diperbarui otomatis oleh klien selama pengguna aktif;
# token penyegar berlaku 7 hari dan dicabut server-side saat logout/ganti kata sandi/idle.
