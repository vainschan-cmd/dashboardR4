# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
cloudflared
scratch/
TUNNEL_URL.txt
~$*.xlsx
~$*.xls

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sqlite wal temporary files
*.db-shm
*.db-wal

# database snapshots and pre-restore copies (may contain personal data)
/backups/
*.pre-restore-*

# SQLite database (berisi hash kata sandi akun; jangan di-commit)
/data/ed_dashboard.db
